{
  "name": "geriz-pdv-desktop",
  "productName": "GERIZ PDV",
  "version": "1.1.1",
  "description": "GERIZ PDV para Windows: abre a Frente de Caixa e imprime o cupom direto na impressora térmica.",
  "author": "GERIZ",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "instalador": "electron-builder --win nsis --x64 --publish never",
    "publicar": "electron-builder --win nsis --x64 --publish always"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.com.geriz.pdv",
    "productName": "GERIZ PDV",
    "artifactName": "GERIZ-PDV-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "escpos.cjs",
      "impressao-crua.cjs",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GERIZ Frente de Caixa",
      "uninstallDisplayName": "GERIZ PDV",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jssantos1229-sketch",
        "repo": "geriz-pdv-app",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
